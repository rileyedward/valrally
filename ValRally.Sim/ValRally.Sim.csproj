<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline handling checks for the rally core. Runs outside the game; not deployed. -->
  <Import Project="$(MSBuildThisFileDirectory)..\Environment.props" Condition="Exists('$(MSBuildThisFileDirectory)..\Environment.props')" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10</LangVersion>
    <RootNamespace>ValRally.Sim</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ValRally.Core\ValRally.Core.csproj" />
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(VALHEIM_INSTALL)\valheim_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
